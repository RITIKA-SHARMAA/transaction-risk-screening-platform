# Copy to .env (git-ignored) and fill in. docker compose reads .env automatically.

# Required. HMAC-SHA256 signing key for access tokens, at least 32 bytes.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Optional overrides (defaults shown).
# JWT_ACCESS_TOKEN_TTL=PT15M
# POSTGRES_HOST_PORT=5433
# REDIS_HOST_PORT=6379
# KAFKA_HOST_PORT=9094
# APP_HOST_PORT=8080
# POSTGRES_PASSWORD=risk_local_only
